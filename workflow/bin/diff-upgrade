#!/usr/bin/env python3
"""Differential test for a framework upgrade: sends the same request corpus to two running copies of the
service (each on its own, empty database) and reports every difference in status, key headers and body.

    workflow/bin/diff-upgrade http://localhost:8081 http://localhost:8082     # old, new

Both databases must start empty, so generated ids line up. Timestamps and other clock-dependent values are
masked before comparing. Exit 0 if no differences, 1 otherwise. Add a request to CORPUS whenever a check or a
review finds behaviour that the corpus didn't exercise.
"""
import json
import re
import sys
import urllib.error
import urllib.request

J = {"Content-Type": "application/json"}


