    add("POST", "/talks", '{"title":"T","format":"PRESENTATION","level":"BEGINNER","speakerId":3.7}')
    add("POST", "/talks", '{"title":"T","format":"PRESENTATION","level":"BEGINNER","speakerId":null}')
