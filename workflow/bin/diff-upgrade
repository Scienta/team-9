    for i, (fmt, lvl) in enumerate([("LIGHTNING_10", "BEGINNER"), ("LIGHTNING_20", "INTERMEDIATE"),
                                    ("WORKSHOP", "ADVANCED"), ("PRESENTATION", "BEGINNER")]):
        add("POST", "/talks", json.dumps({"title": "Talk %d" % i, "format": fmt, "level": lvl, "speakerId": 1}))
    add("POST", "/talks", '{"title":"T","format":"PRESENTATION","level":"BEGINNER","speakerId":2}')
    add("POST", "/talks/", '{"title":"Slash","format":"PRESENTATION","level":"BEGINNER","speakerId":2}')
    add("POST", "/talks", '{"title":"T","format":"PRESENTATION","level":"BEGINNER","speakerId":2,"durationMinutes":5}')
    add("POST", "/talks", '{"title":"T","format":"presentation","level":"BEGINNER","speakerId":3}')
    add("POST", "/talks", '{"title":"T","format":"KEYNOTE","level":"BEGINNER","speakerId":3}')
    add("POST", "/talks", '{"title":"T","format":"PRESENTATION","level":"beginner","speakerId":3}')
    add("POST", "/talks", '{"title":"","format":"PRESENTATION","level":"BEGINNER","speakerId":3}')
