<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>no.scienta</groupId>
    <artifactId>cfp</artifactId>
    <version>1.4.2-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>cfp</name>
    <description>Call for papers backend</description>

    <properties>
        <java.version>25</java.version>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-boot.version>4.1.2</spring-boot.version>
        <pitest.version>1.30.2</pitest.version>
        <pitest-junit5.version>1.2.3</pitest-junit5.version>
        <!-- Override on the command line, e.g. -Dpit.mutationThreshold=60 to fail below 60 % killed. -->
        <pit.mutationThreshold>0</pit.mutationThreshold>
        <pit.threads>2</pit.threads>
        <!-- Narrow a run to what you changed, e.g. -Dpit.targetClasses=no.scienta.cfp.WorkshopService (globs allowed). -->
        <pit.targetClasses>no.scienta.cfp.*</pit.targetClasses>
    </properties>

    <!-- We can't use spring-boot-starter-parent because of the old company parent pom,
         so the Boot BOM is imported instead. -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!--
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>cfp</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
                <configuration>
                    <release>25</release>
                    <!-- Spring 6.1+ needs -parameters to bind @PathVariable/@RequestParam by name (the Boot parent
                         pom would add it, but we import the BOM instead). -->
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.6</version>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Mutation testing with PIT. Opt-in, not part of `./mvnw package`:
               ./mvnw -Pmutation test-compile org.pitest:pitest-maven:mutationCoverage
             or the shortcut `./mvnw -Pmutation verify` (runs the tests, then PIT).
             Report: target/pit-reports/index.html. Needs Docker/Podman like the normal tests:
             every PIT minion JVM starts its own Testcontainers Postgres. -->
        <profile>
            <id>mutation</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <version>${pitest.version}</version>
                        <dependencies>
                            <dependency>
                                <groupId>org.pitest</groupId>
                                <artifactId>pitest-junit5-plugin</artifactId>
                                <version>${pitest-junit5.version}</version>
                            </dependency>
                        </dependencies>
                        <configuration>
                            <targetClasses>
                                <param>${pit.targetClasses}</param>
                            </targetClasses>
                            <targetTests>
                                <param>no.scienta.cfp.*</param>
                            </targetTests>
                            <excludedClasses>
                                <!-- Bootstrap only, nothing to assert on. -->
                                <param>no.scienta.cfp.CfpApplication</param>
                            </excludedClasses>
                            <threads>${pit.threads}</threads>
                            <mutationThreshold>${pit.mutationThreshold}</mutationThreshold>
                            <outputFormats>
                                <param>HTML</param>
                                <param>XML</param>
                            </outputFormats>
                            <timestampedReports>false</timestampedReports>
                            <!-- Integration tests boot Spring and hit Postgres: give mutants more slack. -->
                            <timeoutConstant>10000</timeoutConstant>
                        </configuration>
                        <executions>
                            <execution>
                                <id>pit</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>mutationCoverage</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
